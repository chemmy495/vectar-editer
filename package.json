{
  "name": "vectar-editor",
  "version": "0.1.0",
  "description": "Vectar Editor - a vector graphics editor for Windows with raster image vectorization",
  "license": "CC0-1.0",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import ./scripts/ts-loader.mjs test/**/*.test.ts",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  }
}
